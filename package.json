{
  "name": "gastroforge-academic-api",
  "version": "1.0.0",
  "description": "API académica para análisis de complejidad computacional y algoritmos en Gastroforge",
  "author": "GastroForge Academic Team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
