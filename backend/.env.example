# Port to listen on (Render provides PORT automatically)
PORT=3000

# Base path prefix
GLOBAL_PREFIX=api/v1

# Node Environment (development | production)
NODE_ENV=development

# Neon PostgreSQL (Appresso durable persistence)
# Pooled connection string for application web process (with TLS):
DATABASE_URL=postgresql://neondb_owner:sample_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection string for migration runner (optional, if pooled connection rejects DDL transactions):
DATABASE_URL_DIRECT=postgresql://neondb_owner:sample_password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_SSL=true
# Set to 'true' to automatically execute pending migrations on startup:
TYPEORM_MIGRATIONS_RUN=false

# Appresso Security & Fraud Detection
APPRESSO_HMAC_SECRET=your_secure_hmac_secret_here
APPRESSO_THROTTLE_LIMIT=600
APPRESSO_THROTTLE_TTL=60000

# Redis Cache & Ephemeral State (Phase W3)
REDIS_URL=rediss://default:sample_password@sample-redis.render.com:6379
